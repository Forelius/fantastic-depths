<div class="place-template-buttons flexrow">
   <button class="place-template"
           data-itemuuid="{{itemuuid}}"
           data-owneruuid="{{owneruuid}}"
           data-castas="{{castAs}}"
           data-tooltip="{{localize 'FADE.Chat.placeTemplate.hint'}}">
      <i class="fa-solid fa-ruler-combined"></i>
      <span style="margin-left:4px;">{{localize 'FADE.Chat.placeTemplate.name'}}</span>
   </button>
   <button type="button"
           class="clear-template{{#unless hasPlacedTemplate}} hidden{{/unless}}"
           data-tooltip="{{localize 'FADE.Chat.placeTemplate.clear'}}">
      <i class="fa-solid fa-fw fa-trash"></i>
   </button>
</div>

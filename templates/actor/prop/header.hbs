<header class="sheet-header">
   <img class="profile-img" style="height:80px; width:80px;" src="{{actor.img}}" data-edit="img" data-action="editImage" data-tooltip="{{actor.name}}" />
   <div class="header-fields">
      <ul class="summary flexrow">
         <li>
            <div class="charname">
               <input name="name" class="charname" type="text" value="{{actor.name}}" placeholder="Name" data-tooltip="{{actor.name}}" />
               <label>{{localize 'Name'}}</label>
            </div>
         </li>
      </ul>
   </div>
</header>

<!--Vehicle Abilities Tab-->
<section class="tab abilities {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities">
   <div class="align-vtop">
      {{#if siegeWeapons}}
      <div class="bordered">
         {{#if siegeWeapons}}
         {{!-- Siege Weapons --}}
         {{> "siegeWeapons"}}
         {{/if}}
      </div>
      {{/if}}
   </div>
   <div class="flexrow align-vtop">
      <div class="flex1" style="max-width: 180px;">
         {{> "actorHpAc"}}
         {{#if savingThrows}}
         <div class="flexrow">
            <!-- SAVING THROWS -->
            {{> "actorSaves"}}
         </div>
         {{/if}}
      </div>
      <div class="flex2">
         {{#if (fadeor attackGroups specialAbilities)}}
         <div class="bordered">
            {{#if siegeWeapons}}
            {{!-- Siege Weapons --}}
            {{> "siegeWeapons"}}
            {{/if}}
            {{#if attackGroups}}
            {{!-- Equipped Weapons --}}
            {{> "attackGroups"}}
            {{/if}}
            {{#if specialAbilities}}
            {{!-- Special Abilities --}}
            {{> "actorSpecialAbilities"}}
            {{/if}}
         </div>
         {{/if}}
         {{#if system.encumbrance.max}}
         <div class="flexrow flex-group-center bordered">
            <span class="flex3">
               Total: ({{system.encumbrance.value}} / {{system.encumbrance.max}}) <span data-tooltip="{{system.encumbrance.desc}}">{{system.encumbrance.label}}</span>
            </span>
            {{#if system.movement.modes.0.turn}}
            <span class="flex2">
               {{localize 'FADE.Actor.Movement.moveTurn'}}: {{system.movement.modes.0.turn}}{{#if system.movement.modes.1.turn}} / {{system.movement.modes.1.turn}}{{/if}}
            </span>
            {{/if}}
         </div>
         {{/if}}

         <div class="flexrow">
            {{> "actorMovementModes"}}
         </div>
      </div>
   </div>
</section>
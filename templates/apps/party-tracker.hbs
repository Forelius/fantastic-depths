<form style="display:flex">
   <style>
      #party-tracker-form .scroll-body { padding: 1px; }
      .character-name {
         font-weight: 600;
         font-size: 15px;
         display: inline;
      }
      .small-text{
         font-size:11px;
      }
      .ml-4{
         margin-left:4px;
      }
      .ability-score {
         margin-right: 3px;
      }
   </style>
   <div class="party-tracker">
      <div class="party-tracker-list">
         <!-- Toolbar with XP Button -->
         <div class="party-tracker-toolbar flexrow">
            <div class="flex1">
               <button data-action="awardXP">{{localize 'FADE.dialog.awardXP.short'}}</button>
            </div>            
            <div class="flex2 ml-4">
               TPL: {{tpl}}
            </div>
         </div>

         {{#each trackedActors}}
         <div class="party-member bordered {{ifThen system.combat.isDead "is-dead" "alive"}}" data-actor-id="{{id}}">
            <!-- Delete button positioned in the top-right corner -->
            <span class="delete-actor" data-action="deleteActor" data-tooltip="Remove Actor"><i class="fas fa-trash"></i></span>
            <!-- Actor details -->
            <div>
               <span class="character-name">{{name}}</span>
               <span class="ml-4 small-text">{{system.details.class}}</span>
               <span class="small-text">{{localize 'FADE.Actor.Level'}}: {{system.details.level}}</span>
               <span class="ml-4"></span>
               <span><i class="fas fa-heart" data-tooltip="{{localize 'FADE.Actor.Health'}}"></i> {{system.hp.value}}/{{system.hp.max}}</span>
               <span class="ml-4"><i class="fas fa-shield-halved" data-tooltip="{{localize 'FADE.Armor.total'}}"></i> {{system.ac.total}}</span>
               <span class="ml-4"><i class="fas fa-swords" data-tooltip="{{localize "FADE.Actor.THAC0"}}"></i> {{system.thac0.value}}</span>
               <span class="ml-4">
                  <i class="fas fa-walking" data-tooltip="{{localize 'FADE.Actor.Movement.long'}}"></i> <span data-tooltip="{{localize 'FADE.Actor.Movement.turn'}}">
                     {{system.movement.modes.0.turn}}
                  </span>, <span data-tooltip="{{localize 'FADE.Actor.Movement.round'}}">{{system.movement.modes.0.round}}</span>
               </span>
            </div>
            <div>
               
                  {{#each system.abilities as |ability key|}}
                  <span class="ability-score">{{localize (concat 'FADE.Actor.Abilities.' key '.key')}}: {{ability.total}}</span>
                  {{/each}}
            </div>
         </div>
         {{/each}}
      </div>
   </div>
</form>

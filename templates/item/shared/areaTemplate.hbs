<div class="bordered" style="margin-top:4px;">
   <div class="summary flexrow">
      <div class="flex2">
         <select name="system.template.type" {{#unless isGM}} disabled='disabled' {{/unless}}>
            {{selectOptions templateTypes selected=system.template.type}}
         </select>
         <label for="system.template.type">{{localize 'FADE.AreaTemplate.type'}}</label>
      </div>
      <div class="flex1">
         <input type="text" name="system.template.distance" value="{{system.template.distance}}" data-dtype="String" {{#unless isGM}} readonly{{/unless}} />
         <label for="system.template.distance" data-tooltip="{{localize 'FADE.AreaTemplate.distanceHint'}}">{{localize 'FADE.AreaTemplate.distance'}}</label>
      </div>
      <div class="flex1">
         <input type="text" name="system.template.angle" value="{{system.template.angle}}" data-dtype="String" {{#unless isGM}} readonly{{/unless}} />
         <label for="system.template.angle" data-tooltip="{{localize 'FADE.AreaTemplate.angleHint'}}">{{localize 'FADE.AreaTemplate.angle'}}</label>
      </div>
      <div class="flex1">
         <input type="text" name="system.template.width" value="{{system.template.width}}" data-dtype="String" {{#unless isGM}} readonly{{/unless}} />
         <label for="system.template.width" data-tooltip="{{localize 'FADE.AreaTemplate.widthHint'}}">{{localize 'FADE.AreaTemplate.width'}}</label>
      </div>
   </div>
</div>
